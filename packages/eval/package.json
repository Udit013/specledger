{
  "name": "@specledger/eval",
  "version": "0.0.0",
  "private": true,
  "description": "Synthetic corpus and ground truth, golden-set evaluation runner, metrics and regression gate.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "fixtures:generate": "node dist/corpus/cli.js generate ../../fixtures/corpus",
    "fixtures:validate": "node dist/corpus/cli.js validate ../../fixtures/corpus"
  },
  "dependencies": {
    "@specledger/core": "workspace:*",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "zod": "4.6.7"
  }
}
