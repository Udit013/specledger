{
  "name": "@specledger/ingest",
  "version": "0.0.0",
  "private": true,
  "description": "Upload validation and PDF text extraction in a worker thread.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@specledger/core": "workspace:*",
    "pdfjs-dist": "6.5.438",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1"
  }
}
