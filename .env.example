# Copy to .env for local development:  cp .env.example .env
# .env is ignored by Git and blocked by the pre-commit hook. Never commit real credentials.
# The values below are local-development defaults only.

# ---------------------------------------------------------------------------
# API service. Validated at startup by apps/api/src/config.ts; an invalid or
# missing key stops the process and is reported by name, never by value.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production. Optional, default: development
NODE_ENV=development

# Interface the API binds to. Optional, default: 127.0.0.1
HOST=127.0.0.1

# TCP port, integer 1-65535. Optional, default: 3000
PORT=3000

# Log level: fatal | error | warn | info | debug | trace | silent. Optional, default: info
LOG_LEVEL=info

# Postgres connection URL (postgres:// or postgresql://). Required.
# Matches the local container defined in docker-compose.yml.
DATABASE_URL=postgres://specledger:specledger_local_only@127.0.0.1:5432/specledger

# ---------------------------------------------------------------------------
# Upload limits (packages/ingest). All optional; the defaults below are used
# when a key is unset. Each value must be an integer inside the bounds shown,
# so a typo cannot switch a limit off.
# ---------------------------------------------------------------------------

# Largest accepted upload in bytes (10 MiB). Bounds: 1024 - 104857600
INGEST_MAX_BYTES=10485760

# Most pages a document may have. Bounds: 1 - 1000
INGEST_MAX_PAGES=50

# Hard wall-clock limit for parsing one PDF in its worker thread, in ms. The
# worker is terminated when it is reached. Bounds: 100 - 120000
INGEST_PARSE_TIMEOUT_MS=15000

# Memory budget of the parsing worker thread, in MB: its heap limit, and the
# limit a watchdog applies to heap plus decoded stream buffers, which live
# outside the heap (decompression bombs). Bounds: 32 - 2048
INGEST_PARSE_MEMORY_MB=256

# A document with fewer non-whitespace characters than this in total has no
# text layer (for example a scan) and is rejected. Bounds: 1 - 10000
INGEST_MIN_TEXT_CHARS=20

# ---------------------------------------------------------------------------
# Local Postgres container (docker-compose.yml). All optional; defaults shown.
# The password is a local-only default for a container bound to 127.0.0.1.
# ---------------------------------------------------------------------------
POSTGRES_USER=specledger
POSTGRES_PASSWORD=specledger_local_only
POSTGRES_DB=specledger
POSTGRES_PORT=5432
