# Copy to .env for local development:  cp .env.example .env
# .env is ignored by Git and blocked by the pre-commit hook. Never commit real credentials.
# The values below are local-development defaults only.

# ---------------------------------------------------------------------------
# API service. Validated at startup by apps/api/src/config.ts; an invalid or
# missing key stops the process and is reported by name, never by value.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production. Optional, default: development
NODE_ENV=development

# Interface the API binds to. Optional, default: 127.0.0.1
HOST=127.0.0.1

# TCP port, integer 1-65535. Optional, default: 3000
PORT=3000

# Log level: fatal | error | warn | info | debug | trace | silent. Optional, default: info
LOG_LEVEL=info

# Postgres connection URL (postgres:// or postgresql://). Required.
# Matches the local container defined in docker-compose.yml.
DATABASE_URL=postgres://specledger:specledger_local_only@127.0.0.1:5432/specledger

# ---------------------------------------------------------------------------
# Upload limits (packages/ingest). All optional; the defaults below are used
# when a key is unset. Each value must be an integer inside the bounds shown,
# so a typo cannot switch a limit off.
# ---------------------------------------------------------------------------

# Largest accepted upload in bytes (10 MiB). Bounds: 1024 - 104857600
INGEST_MAX_BYTES=10485760

# Most pages a document may have. Bounds: 1 - 1000
INGEST_MAX_PAGES=50

# Hard wall-clock limit for parsing one PDF in its worker thread, in ms. The
# worker is terminated when it is reached. Bounds: 100 - 120000
INGEST_PARSE_TIMEOUT_MS=15000

# Memory budget of the parsing worker thread, in MB: its heap limit, and the
# limit a watchdog applies to heap plus decoded stream buffers, which live
# outside the heap (decompression bombs). Bounds: 32 - 2048
INGEST_PARSE_MEMORY_MB=256

# A document with fewer non-whitespace characters than this in total has no
# text layer (for example a scan) and is rejected. Bounds: 1 - 10000
INGEST_MIN_TEXT_CHARS=20

# ---------------------------------------------------------------------------
# HTTP API (apps/api). The API refuses to start without both tokens; the
# worker does not need them.
# ---------------------------------------------------------------------------

# Bearer tokens, one per role, 32-256 URL-safe characters each, different from
# each other. Generate with: openssl rand -hex 32
# Leave empty here and set them in your untracked .env.
API_ENGINEER_TOKEN=
API_APPROVER_TOKEN=

# Origins allowed by CORS, comma-separated (scheme://host[:port], no path).
# Optional, default: empty (no cross-origin access)
CORS_ORIGINS=

# Whether to trust X-Forwarded-For: false, true, or a hop count 1-9. Set it
# only behind a proxy you control. Optional, default: false
TRUST_PROXY=false

# Requests per minute per client IP, for all routes. Bounds: 1 - 100000
RATE_LIMIT_PER_MINUTE=300

# Uploads per minute per client IP (POST /documents). Bounds: 1 - 10000
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Time limit for one request, in ms. Bounds: 1000 - 600000
REQUEST_TIMEOUT_MS=60000

# Largest JSON request body in bytes (uploads use INGEST_MAX_BYTES).
# Bounds: 1024 - 10485760
JSON_BODY_LIMIT_BYTES=1048576

# none (default) accepts any valid PDF; corpus accepts only the synthetic test PDFs listed in
# fixtures/corpus/manifest.json, for a public demo. Optional, default: none
UPLOAD_ALLOWLIST=none

# The public demo workspace (optional; served by `pnpm serve`). A database other than
# DATABASE_URL: visitors get signed sessions for /demo routes bound to it, and an empty one is
# seeded with curated corpus documents. Locally, for example:
#   docker compose exec postgres createdb -U specledger specledger_demo
# then postgres://specledger:specledger_local_only@127.0.0.1:5432/specledger_demo
DEMO_DATABASE_URL=
# Signs visitor sessions: 32 or more URL-safe characters (openssl rand -hex 32). Required with
# DEMO_DATABASE_URL.
DEMO_SESSION_SECRET=
# How long a visitor session lasts, in minutes (5 to 1440).
DEMO_SESSION_TTL_MINUTES=120

# ---------------------------------------------------------------------------
# Local Postgres container (docker-compose.yml). All optional; defaults shown.
# The password is a local-only default for a container bound to 127.0.0.1.
# ---------------------------------------------------------------------------
POSTGRES_USER=specledger
POSTGRES_PASSWORD=specledger_local_only
POSTGRES_DB=specledger
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Model provider (packages/llm). Tests, CI and demos use recorded responses
# (Replay) and need none of this. Content sent to the Gemini free tier may be
# used to improve Google's products: only synthetic documents are sent, and the
# provider refuses any request not flagged synthetic.
# ---------------------------------------------------------------------------

# Which provider the worker extracts with: replay (recorded responses from
# fixtures/recordings: free, deterministic, no network; the demo default) or
# gemini (the Gemini free tier, failing over to replay). Optional, default: replay
LLM_PROVIDER=replay

# Gemini API key from Google AI Studio. Required when LLM_PROVIDER is gemini;
# `pnpm llm:smoke` also uses it. Leave empty here and set it in your untracked .env.
GEMINI_API_KEY=

# Model id. Optional, default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Time limit for one extraction call from the worker, in ms. Bounds: 1000 - 300000
LLM_TIMEOUT_MS=60000

# Set to 1 to let `pnpm llm:smoke` save its answer under fixtures/recordings/.
# Optional, default: unset (recording refused)
RECORD=
