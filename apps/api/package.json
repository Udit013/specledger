{
  "name": "@specledger/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify routes, auth, error mapping and worker entry point.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "llm:smoke": "node --env-file-if-exists=../../.env dist/scripts/llm-smoke.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker/main.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@specledger/core": "workspace:*",
    "@specledger/db": "workspace:*",
    "@specledger/eval": "workspace:*",
    "@specledger/exporters": "workspace:*",
    "@specledger/ingest": "workspace:*",
    "@specledger/llm": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
