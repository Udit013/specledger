{
  "name": "specledger",
  "version": "0.0.0",
  "private": true,
  "description": "Datasheet to verified equipment register: every specification, with its proof.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "verify": "turbo run typecheck lint test build && pnpm run boundaries",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run build && vitest run --config vitest.integration.config.js",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up --detach --wait postgres",
    "hooks:install": "sh scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
